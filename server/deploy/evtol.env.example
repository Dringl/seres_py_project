# 复制到 /etc/evtol.env 后按需修改（systemd EnvironmentFile）
# 这些是进程环境变量，pydantic-settings 大小写不敏感地映射到 Settings 字段。

# SQLite 数据库文件（放在 systemd StateDirectory 创建的 /var/lib/evtol 下）
DB_PATH=/var/lib/evtol/evtol.sqlite

# 管理端凭据（计划二的 Web 管理台用；首次启动据此播种初始管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码

# 会话/令牌签名密钥（计划二用），生成：openssl rand -hex 32
SECRET_KEY=请替换为随机十六进制

# app 端可选弱校验密钥；留空表示不校验
APP_API_KEY=

# 高德 Web 端 Key（计划二总览大屏地图用，可空；空则地图块留白不影响功能）
GAODE_WEB_KEY=
# 高德 JS API v2.0 安全密钥（与上面的 key 配对，控制台同处获取）
GAODE_WEB_SECRET=
